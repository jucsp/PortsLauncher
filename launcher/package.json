{
  "name": "portslauncher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PortsLauncher — lanzador unificado de ports de juegos a PC, Linux y Android.",
  "author": "PortsLauncher",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "icon": "node build/generate-icon.mjs",
    "prebuild": "node build/generate-icon.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron .",
    "electron:dev": "vite",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "cl.garagelabs.portslauncher",
    "productName": "PortsLauncher",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Game"
    },
    "win": {
      "target": ["nsis", "portable"]
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "marked": "^18.1.2"
  }
}
